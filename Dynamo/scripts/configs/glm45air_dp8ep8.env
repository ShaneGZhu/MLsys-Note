# GLM-4.5-Air：整机 8 卡 1 个 worker，DP-attention + EP（每机 1 worker，4 机共 4 worker）
#
# 约束（来自 sglang/srt/server_args.py check_server_args / arg_groups/overrides.py）：
#   - 总卡数 = tp_size × pp_size；dp-attention 复用 TP group，不额外占卡
#   - tp_size % dp_size == 0；--enable-dp-attention 的推荐用法是 dp_size == tp_size
#   - dp_size == 1 时 enable_dp_attention / enable_dp_lm_head 会被静默重置为 False
#   - --enable-dp-lm-head 必须与 --enable-dp-attention 同时开
#   - moe_a2a_backend != none（如 deepep）时 ep_size 被强制改写为 tp_size，手写 --ep-size 无效；
#     a2a=none 且 ep_size > 1 时要求 ep_size × moe_dp_size == tp_size
#   - chunked_prefill_size 会被自动除以 dp_size
MODEL_NAME="zai-org/GLM-4.5-Air"
MODEL_PATH=/root/paddlejob/workspace/env_run/output/zhushengguang/models/GLM-4.5-Air
CHAT_TEMPLATE="$MODEL_PATH/chat_template.jinja"

GPUS_PER_WORKER=8

ENGINE_ARGS=(
    --tp-size 8
    --dp-size 8
    --enable-dp-attention
    --enable-dp-lm-head
    --ep-size 8
    --moe-a2a-backend none
    --page-size 16
    --context-length 131072
    --mem-fraction-static 0.80
    --trust-remote-code
    --enable-metrics
    --disable-piecewise-cuda-graph
)
