Dynamo Frontend: HTTP+Pre-processor+Router

options:
  -h, --help            show this help message and exit
  --version             show program's version number and exit

Dynamo Frontend Options:
  -i, --interactive, --no-interactive
                        Interactive text chat.
                        env var: DYN_INTERACTIVE
  --namespace NAMESPACE
                        Dynamo namespace for model discovery scoping. Use for exact namespace matching. If --namespace-prefix is also specified, prefix takes precedence.
                        env var: DYN_NAMESPACE | default: None
  --kv-cache-block-size KV_CACHE_BLOCK_SIZE
                        KV cache block size (u32).
                        env var: DYN_KV_CACHE_BLOCK_SIZE | default: None
  --http-host HTTP_HOST
                        HTTP host for the engine (str).
                        env var: DYN_HTTP_HOST | default: 0.0.0.0
  --http-port HTTP_PORT
                        HTTP port for the engine (u16).
                        env var: DYN_HTTP_PORT | default: 8000
  --serve-indexer, --no-serve-indexer
                        Serve this frontend's local KV indexers over the request plane.
                        env var: DYN_SERVE_INDEXER | default: False
  --tls-cert-path TLS_CERT_PATH
                        TLS certificate path, PEM format.
                        env var: DYN_TLS_CERT_PATH | default: None
  --tls-key-path TLS_KEY_PATH
                        TLS certificate key path, PEM format.
                        env var: DYN_TLS_KEY_PATH | default: None
  --namespace-prefix NAMESPACE_PREFIX
                        Dynamo namespace prefix for model discovery scoping. Discovers models from namespaces starting with this prefix (e.g., 'ns' matches 'ns', 'ns-abc123', 'ns-def456'). Takes precedence over --namespace if both are specified.
                        env var: DYN_NAMESPACE_PREFIX | default: None
  --migration-limit MIGRATION_LIMIT
                        Maximum number of times a request may be migrated to a different engine worker. When > 0, enables request migration on worker disconnect.
                        env var: DYN_MIGRATION_LIMIT | default: 0
  --migration-max-seq-len MIGRATION_MAX_SEQ_LEN
                        Maximum sequence length (prompt + generated tokens) for migration state tracking. Once the accumulated token count exceeds this limit, the request becomes non-migratable. Prevents unbounded memory growth from caching long sequences. Default: no limit.
                        env var: DYN_MIGRATION_MAX_SEQ_LEN | default: None
  --model-name MODEL_NAME
                        Model name as a string (e.g., 'Llama-3.2-1B-Instruct')
                        env var: DYN_MODEL_NAME | default: None
  --model-path MODEL_PATH
                        Path to model directory on disk (e.g., /tmp/model_cache/llama3.2_1B/)
                        env var: DYN_MODEL_PATH | default: None
  --metrics-prefix METRICS_PREFIX
                        Prefix for Dynamo frontend metrics. If unset, uses DYN_METRICS_PREFIX env var or 'dynamo_frontend'.
                        env var: DYN_METRICS_PREFIX | default: None
  --kserve-grpc-server, --no-kserve-grpc-server
                        Start KServe gRPC server.
                        env var: DYN_KSERVE_GRPC_SERVER | default: False
  --grpc-metrics-port GRPC_METRICS_PORT
                        HTTP metrics port for gRPC service (u16). Only used with --kserve-grpc-server. Defaults to 8788.
                        env var: DYN_GRPC_METRICS_PORT | default: 8788
  --dump-config-to DUMP_CONFIG_TO
                        Dump config to the specified file path.
                        env var: DYN_DUMP_CONFIG_TO | default: None
  --frontend-route-extension FRONTEND_ROUTE_EXTENSIONS
                        Trusted frontend route extension: a name registered under the 'dynamo.frontend.routes' entry-point group, or a 'module:function' path. May be repeated. DYN_FRONTEND_ROUTE_EXTENSIONS accepts whitespace-separated values.
                        env var: DYN_FRONTEND_ROUTE_EXTENSIONS | default: []
  --discovery-backend {kubernetes,etcd,file,mem}
                        Discovery backend: kubernetes (K8s API), etcd (distributed KV), file (local filesystem), mem (in-memory). Etcd uses the ETCD_* env vars (e.g. ETCD_ENDPOINTS) for connection details. File uses root dir from env var DYN_FILE_KV or defaults to $TMPDIR/dynamo_store_kv.
                        env var: DYN_DISCOVERY_BACKEND | default: etcd
  --request-plane {nats,tcp}
                        Determines how requests are distributed from routers to workers. 'tcp' is fastest [nats|tcp]
                        env var: DYN_REQUEST_PLANE | default: tcp
  --event-plane {nats,zmq}
                        Determines how events are published [nats|zmq]. If unset, defaults to 'zmq' for all discovery backends. Set to 'nats' to use a NATS-based event plane.
                        env var: DYN_EVENT_PLANE | default: None
  --enable-anthropic-api, --no-enable-anthropic-api
                        [EXPERIMENTAL] Enable Anthropic Messages API endpoint (/v1/messages). This feature is experimental and may change.
                        env var: DYN_ENABLE_ANTHROPIC_API | default: False
  --strip-anthropic-preamble, --no-strip-anthropic-preamble
                        Strip the Claude Code billing preamble (x-anthropic-billing-header) from the system prompt. Saves tokens and improves prompt caching.
                        env var: DYN_STRIP_ANTHROPIC_PREAMBLE | default: False
  --enable-streaming-tool-dispatch, --no-enable-streaming-tool-dispatch
                        [EXPERIMENTAL] Enable streaming tool call dispatch. Emits 'event: tool_call_dispatch' SSE events on /v1/chat/completions for each complete tool call before finish_reason arrives. Can be combined with --enable-streaming-reasoning-dispatch.
                        env var: DYN_ENABLE_STREAMING_TOOL_DISPATCH | default: False
  --enable-streaming-reasoning-dispatch, --no-enable-streaming-reasoning-dispatch
                        [EXPERIMENTAL] Enable streaming reasoning dispatch. Emits a single 'event: reasoning_dispatch' SSE event on /v1/chat/completions with the complete reasoning block once thinking ends. Can be combined with --enable-streaming-tool-dispatch.
                        env var: DYN_ENABLE_STREAMING_REASONING_DISPATCH | default: False
  --exclude-tools-when-tool-choice-none, --no-exclude-tools-when-tool-choice-none
                        Exclude tool definitions from the chat template when tool_choice='none'. Prevents models from generating raw XML tool calls in the content field.
                        env var: DYN_EXCLUDE_TOOLS_WHEN_TOOL_CHOICE_NONE | default: True
  --dyn-chat-processor {dynamo,vllm,sglang}
                        [EXPERIMENTAL] Chat pre/post processor backend. 'dynamo' uses the Rust preprocessor. 'vllm' uses local vLLM for pre and post processing. 'sglang' uses SGLang APIs for chat template rendering, tool call parsing, and reasoning parsing.
                        env var: DYN_CHAT_PROCESSOR | default: dynamo
  --dyn-debug-perf, --no-dyn-debug-perf
                        [EXPERIMENTAL] Enable performance instrumentation for diagnosing preprocessing bottlenecks. Logs per-function timing, request concurrency, and hot-path section durations. Supported with '--dyn-chat-processor vllm' and '--dyn-chat-processor sglang'.
                        env var: DYN_DEBUG_PERF | default: False
  --dyn-preprocess-workers PREPROCESS_WORKERS
                        [EXPERIMENTAL] Number of worker processes for preprocessing and output processing. When > 0, offloads CPU-bound work (tokenization, template rendering, detokenization) to a ProcessPoolExecutor with N workers, each with its own GIL. 0 (default) keeps all processing on the main event loop. Supported with '--dyn-chat-processor vllm' and '--dyn-chat-processor sglang'.
                        env var: DYN_PREPROCESS_WORKERS | default: 0
  --tokenizer {default,fastokens}
                        Tokenizer backend for BPE models: 'default' (HuggingFace tokenizers library) or 'fastokens' (fastokens crate for high-performance BPE encoding). Decoding always uses HuggingFace. Has no effect on TikToken models.
                        env var: DYN_TOKENIZER | default: default
  --trust-remote-code, --no-trust-remote-code
                        Trust remote code when loading the tokenizer. Required for models that ship custom tokenizer code (e.g. Qwen, Falcon).
                        env var: DYN_TRUST_REMOTE_CODE | default: False

Router Options:
  --router-mode {round-robin,random,power-of-two,kv,direct,least-loaded,device-aware-weighted}
                        How to route the request. power-of-two picks 2 random workers and routes to the one with fewer in-flight requests. least-loaded routes to the worker with the fewest active requests. device-aware-weighted routes based on worker device type (CPU/CUDA). In disaggregated prefill mode, both power-of-two and least-loaded skip bootstrap optimization and fall back to the synchronous prefill path.
                        env var: DYN_ROUTER_MODE | default: round-robin
  --router-min-initial-workers MIN_INITIAL_WORKERS
                        Minimum number of workers required before router startup continues. This is exported as DYN_ROUTER_MIN_INITIAL_WORKERS so the generic push-router path and the KV router's config-ready worker gate share the same startup threshold. Set to 0 to disable the startup wait.
                        env var: DYN_ROUTER_MIN_INITIAL_WORKERS | default: 0
  --router-session-affinity-ttl-secs SESSION_AFFINITY_TTL_SECS
                        Enable session affinity with this router-local idle TTL in seconds. Bindings synchronize across router replicas on a best-effort basis. Affinity is disabled when this option is omitted. This is independent of KV prediction TTL settings.
                        env var: DYN_ROUTER_SESSION_AFFINITY_TTL_SECS | default: None
  --enforce-disagg, --no-enforce-disagg
                        DEPRECATED: accepted for compatibility but ignored. Routing topology and readiness are determined from registered worker types.
                        env var: DYN_ENFORCE_DISAGG | default: False
  --active-decode-blocks-threshold ACTIVE_DECODE_BLOCKS_THRESHOLD
                        Threshold fraction (0.0-1.0) of KV cache block utilization above which a worker is considered busy. Setting a numeric value enables this rejection check. Unset by default; pass 'None' to disable it.
                        env var: DYN_ACTIVE_DECODE_BLOCKS_THRESHOLD | default: None
  --active-prefill-tokens-threshold ACTIVE_PREFILL_TOKENS_THRESHOLD
                        Literal token count threshold for determining when a worker is considered busy based on prefill token utilization. When active prefill tokens exceed this threshold, the worker is marked as busy. Setting a numeric value enables this rejection check. Unset by default; pass 'None' to disable it. Uses OR logic with --active-prefill-tokens-threshold-frac.
                        env var: DYN_ACTIVE_PREFILL_TOKENS_THRESHOLD | default: None
  --active-prefill-tokens-threshold-frac ACTIVE_PREFILL_TOKENS_THRESHOLD_FRAC
                        Fraction of max_num_batched_tokens for busy detection. Worker is busy when active_prefill_tokens > frac * max_num_batched_tokens. Setting a numeric value enables this rejection check. Unset by default; pass 'None' to disable it. Uses OR logic with --active-prefill-tokens-threshold.
                        env var: DYN_ACTIVE_PREFILL_TOKENS_THRESHOLD_FRAC | default: None

KV Router Options:
  --load-aware, --no-load-aware
                        KV Router: Enable load-aware routing without cache-reuse signals. On the frontend, this implies --router-mode kv. This preset sets overlap_score_credit=0, disables KV events and KV-reuse assumptions, enables active-block and prefill-token load tracking, and disables remote/shared cache indexers.
                        env var: DYN_ROUTER_LOAD_AWARE | default: False
  --router-kv-overlap-score-credit OVERLAP_SCORE_CREDIT
                        KV Router: Credit multiplier for device-local prefix overlap. Must be finite and non-negative; values above 1.0 give device overlap extra credit and can make the adjusted prefill cost negative.
                        env var: DYN_ROUTER_KV_OVERLAP_SCORE_CREDIT | default: 1.0
  --router-kv-overlap-score-credit-decay OVERLAP_SCORE_CREDIT_DECAY
                        KV Router: Decay rate for device-local overlap credit as active prefill load rises above the least-loaded eligible worker. 0 disables decay; 1 halves credit at one request-equivalent of excess active prefill load.
                        env var: DYN_ROUTER_KV_OVERLAP_SCORE_CREDIT_DECAY | default: 0.0
  --router-prefill-load-scale PREFILL_LOAD_SCALE
                        KV Router: Scale applied to adjusted prompt-side prefill load after overlap and lower-tier cache-hit credits are subtracted.
                        env var: DYN_ROUTER_PREFILL_LOAD_SCALE | default: 1.0
  --router-host-cache-hit-weight HOST_CACHE_HIT_WEIGHT
                        KV Router: Credit multiplier for host-pinned (CPU offload) prefix overlap. Range: 0.0 to 1.0; higher values more strongly prefer workers holding the prefix in CPU-tier KV cache. Symmetric to --router-kv-overlap-score-credit but applied to host_pinned tier overlap.
                        env var: DYN_ROUTER_HOST_CACHE_HIT_WEIGHT | default: 0.75
  --router-disk-cache-hit-weight DISK_CACHE_HIT_WEIGHT
                        KV Router: Credit multiplier for disk/lower-tier (e.g. NVMe-backed) prefix overlap. Range: 0.0 to 1.0. Same semantics as --router-host-cache-hit-weight applied to the disk tier.
                        env var: DYN_ROUTER_DISK_CACHE_HIT_WEIGHT | default: 0.25
  --router-temperature ROUTER_TEMPERATURE
                        KV Router: Temperature for normalized worker sampling via softmax. Higher values promote more randomness, and 0 falls back to deterministic.
                        env var: DYN_ROUTER_TEMPERATURE | default: 0.0
  --router-kv-events, --no-router-kv-events, --kv-events, --no-kv-events
                        KV Router: Enable/disable KV events. Use --router-kv-events to enable (default, router receives cache state events from workers) or --no-router-kv-events to disable (router predicts cache state based on routing decisions).
                        env var: DYN_ROUTER_USE_KV_EVENTS | default: True
                        deprecating flag: --kv-events
  --router-replica-sync, --no-router-replica-sync
                        KV Router: Enable best-effort active-sequence synchronization through the Runtime event plane.
                        env var: DYN_ROUTER_REPLICA_SYNC | default: False
  --router-track-active-blocks, --no-router-track-active-blocks, --track-active-blocks, --no-track-active-blocks
                        KV Router: Track active blocks (blocks being used for ongoing generation). By default, active blocks are tracked for load balancing.
                        env var: DYN_ROUTER_TRACK_ACTIVE_BLOCKS | default: True
                        deprecating flag: --track-active-blocks
  --router-track-output-blocks, --no-router-track-output-blocks, --track-output-blocks, --no-track-output-blocks
                        KV Router: Track output blocks during generation. When enabled, the router adds placeholder blocks as tokens are generated and applies fractional decay based on progress toward expected output sequence length.
                        env var: DYN_ROUTER_TRACK_OUTPUT_BLOCKS | default: False
                        deprecating flag: --track-output-blocks
  --router-assume-kv-reuse, --no-router-assume-kv-reuse, --assume-kv-reuse, --no-assume-kv-reuse
                        KV Router: When tracking active blocks, assume KV cache reuse. Use --no-router-assume-kv-reuse to generate random hashes instead (when KV cache reuse is not expected).
                        env var: DYN_ROUTER_ASSUME_KV_REUSE | default: True
                        deprecating flag: --assume-kv-reuse
  --router-track-prefill-tokens, --no-router-track-prefill-tokens
                        KV Router: Include prompt-side prefill tokens in active load accounting. Use --no-router-track-prefill-tokens to ignore prompt tokens in router prefill-token load, queue pressure, and active_prefill_tokens metrics.
                        env var: DYN_ROUTER_TRACK_PREFILL_TOKENS | default: True
  --router-tracking-hash {public-xxh3-v1,keyed-xxh3-v1}
                        KV Router: Hash function for router-derived active-sequence identities.
                        env var: DYN_ROUTER_TRACKING_HASH | default: public-xxh3-v1
  --router-tracking-key-file ROUTER_TRACKING_KEY_FILE
                        KV Router: File containing the 32-byte provider tracking key.
                        env var: DYN_ROUTER_TRACKING_KEY_FILE | default: None
  --router-tracking-key-id ROUTER_TRACKING_KEY_ID
                        KV Router: Provider-managed tracking-key epoch identifier.
                        env var: DYN_ROUTER_TRACKING_KEY_ID | default: None
  --router-prefill-load-model {none,aic}
                        [EXPERIMENTAL] KV Router: Prompt-side prefill load model. 'none' keeps static prompt load accounting. 'aic' decays the oldest active prefill request using AIC-predicted duration.
                        env var: DYN_ROUTER_PREFILL_LOAD_MODEL | default: none
  --router-ttl-secs ROUTER_TTL_SECS
                        KV Router: Time-to-live in seconds for blocks when KV events are disabled. Only used when --no-router-kv-events is set.
                        env var: DYN_ROUTER_TTL_SECS | default: 120.0
  --router-queue-threshold ROUTER_QUEUE_THRESHOLD
                        KV Router: Queue threshold fraction for prefill token capacity. Requests are queued if all workers exceed this fraction of max_num_batched_tokens. Must be >= 0. Use 0.0 for maximum queueing sensitivity (queue once every eligible worker has active prefill load). Unset by default; setting a numeric value enables router queueing. Note (SGLang backend): when --max-prefill-tokens is not set, MDC's max_num_batched_tokens falls back to max_total_num_tokens (the KV cache pool size), not the per-step prefill window, which inflates the threshold's effective denominator. Set --max-prefill-tokens explicitly for predictable semantics, or use a smaller threshold.
                        env var: DYN_ROUTER_QUEUE_THRESHOLD | default: None
  --router-policy-config ROUTER_POLICY_CONFIG
                        KV Router: Startup-only YAML policy-family and cache-bucket queue configuration. When omitted, router_queue_threshold and router_queue_policy define one synthetic policy class; queueing remains disabled unless router_queue_threshold is set.
                        env var: DYN_ROUTER_POLICY_CONFIG | default: None
  --router-event-threads ROUTER_EVENT_THREADS
                        KV Router: Number of KV indexer worker threads. When > 1, uses a concurrent radix tree with a thread pool for higher throughput, including approximate routing when --no-router-kv-events is set.
                        env var: DYN_ROUTER_EVENT_THREADS | default: 4
  --router-queue-policy {fcfs,wspt}
                        KV Router: Scheduling policy for the router queue. 'fcfs' (default): first-come first-served with priority bumps — optimizes tail TTFT. 'wspt': weighted shortest processing time (Smith's rule) — optimizes average TTFT.
                        env var: DYN_ROUTER_QUEUE_POLICY | default: fcfs
  --use-remote-indexer, --no-use-remote-indexer
                        [EXPERIMENTAL] KV Router: Query a remote KV indexer served from the worker component via the request plane instead of maintaining a local radix tree.
                        env var: DYN_USE_REMOTE_INDEXER | default: False
  --shared-cache-multiplier SHARED_CACHE_MULTIPLIER
                        [EXPERIMENTAL] KV Router: Multiplier for shared cache hits (0.0-1.0). Blocks in the shared cache are less valuable than device-local blocks. E.g. 0.5 means each shared hit counts as half a device-local hit. Default 0.5.
                        env var: DYN_SHARED_CACHE_MULTIPLIER | default: 0.5
  --shared-cache-type {none,hicache}
                        [EXPERIMENTAL] KV Router: Type of external shared KV cache to query. 'none' (default): disabled. 'hicache': query Mooncake master directly for SGLang L3 (HiCache) state using SGLang-compatible Mooncake key derivation.
                        env var: DYN_SHARED_CACHE_TYPE | default: none
  --router-predicted-ttl-secs ROUTER_PREDICTED_TTL_SECS
                        KV Router: Enable predict-on-route with this TTL in seconds for entries in the local side indexer. Requires KV events; omit to disable. Independent of --router-ttl-secs, which covers pure approximate mode.
                        env var: DYN_ROUTER_PREDICTED_TTL_SECS | default: None

AIC Perf Model Options:
  --aic-backend AIC_BACKEND
                        [EXPERIMENTAL] AIC backend family to model (for example: vllm or sglang).
                        env var: DYN_AIC_BACKEND | default: None
  --aic-system AIC_SYSTEM
                        [EXPERIMENTAL] AIC hardware/system identifier (for example: h200_sxm).
                        env var: DYN_AIC_SYSTEM | default: None
  --aic-backend-version AIC_BACKEND_VERSION
                        [EXPERIMENTAL] Pinned backend version for AIC database lookup.
                        env var: DYN_AIC_BACKEND_VERSION | default: None
  --aic-tp-size AIC_TP_SIZE
                        [EXPERIMENTAL] Tensor parallel size to model in AIC.
                        env var: DYN_AIC_TP_SIZE | default: 1
  --aic-model-path AIC_MODEL_PATH
                        [EXPERIMENTAL] Model path or model identifier to use for AIC perf lookup.
                        env var: DYN_AIC_MODEL_PATH | default: None
  --aic-moe-tp-size AIC_MOE_TP_SIZE
                        [EXPERIMENTAL] MoE tensor-parallel size to model in AIC. Required by some MoE models.
                        env var: DYN_AIC_MOE_TP_SIZE | default: None
  --aic-moe-ep-size AIC_MOE_EP_SIZE
                        [EXPERIMENTAL] MoE expert-parallel size to model in AIC. Required by some MoE models.
                        env var: DYN_AIC_MOE_EP_SIZE | default: None
  --aic-attention-dp-size AIC_ATTENTION_DP_SIZE
                        [EXPERIMENTAL] Attention data-parallel size to model in AIC.
                        env var: DYN_AIC_ATTENTION_DP_SIZE | default: None
  --aic-nextn AIC_NEXTN
                        [EXPERIMENTAL] MTP/Eagle speculative-decoding draft-token count for AIC latency modeling (max 5). Omit to disable spec dec.
                        env var: DYN_AIC_NEXTN | default: None
  --aic-nextn-accept-rates AIC_NEXTN_ACCEPT_RATES
                        [EXPERIMENTAL] Comma-separated conditional accept rates for MTP draft tokens. Entry i is P(draft i accepted | all earlier drafts were accepted). Values are padded or truncated to --aic-nextn.
                        env var: DYN_AIC_NEXTN_ACCEPT_RATES | default: None
  --aic-mtp-seed AIC_MTP_SEED
                        [EXPERIMENTAL] Base RNG seed for mocker MTP burst sampling.
